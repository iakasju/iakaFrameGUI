{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iakaFrameGUI",
  "version": "0.1.7",
  "identifier": "com.iakateam.iakaframegui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3030",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "iakaFrameGUI",
        "width": 1180,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0NUVGRkJGRDZFNDk1RDAKUldUUWxlVFd2LzllMUJxYm8vZHY4SHRsbjF1VjdoTW0zREt2UlJETE02UUFpRGhtNHE2Nk01R2gK",
      "dangerousInsecureTransportProtocol": true,
      "endpoints": [
        "http://192.168.1.139:3001/sjupin/iakaFrameGUI/raw/branch/main/updater/latest.json",
        "https://raw.githubusercontent.com/iakasju/iakaFrameGUI/main/updater/latest.json",
        "http://192.168.2.11:3001/sjupin/iakaFrameGUI/raw/branch/main/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
