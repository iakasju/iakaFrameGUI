{
  "name": "iakaframegui",
  "private": true,
  "version": "0.1.1",
  "description": "iakaFrameGUI - la forge de la methode iakaframe (authoring de teams PURES). Coquille Tauri React+Rust.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:all": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:all": "npm run test",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri"
  },
  "dependencies": {
    "@iakaframe/core": "*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.61.1",
    "vite": "^6",
    "vitest": "^4.1.9"
  }
}
